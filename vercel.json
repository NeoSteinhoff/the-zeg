{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.+)",
      "dest": "/data/static/$1.json"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "github": {
    "enabled": true
  },
  "rewrites": [
    { "source": "/api/command-center", "destination": "/data/static/command-center.json" },
    { "source": "/api/circle-pipeline", "destination": "/data/static/circle-pipeline.json" },
    { "source": "/api/mesh-crm", "destination": "/data/static/mesh-crm.json" },
    { "source": "/api/goals", "destination": "/data/static/goals.json" },
    { "source": "/api/timeline", "destination": "/data/static/timeline.json" },
    { "source": "/api/soul-engine", "destination": "/data/static/soul-engine.json" },
    { "source": "/api/storefront", "destination": "/data/static/storefront.json" },
    { "source": "/api/ecosystem", "destination": "/data/static/ecosystem.json" },
    { "source": "/api/hermes-control", "destination": "/data/static/hermes-control.json" },
    { "source": "/api/aurora-brain", "destination": "/data/static/aurora-brain.json" }
  ]
}

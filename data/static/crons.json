    {
      "id": "a15ead6675cf",
      "name": "Hermes \u2192 Zeg Live Bridge",
      "schedule": "every 1m",
      "state": "scheduled",
      "enabled": true,
      "completed": 58,
      "model": null,
      "provider": null,
      "script": "#!/bin/bash\n# Hermes \u2192 Zeg real-time bridge watcher\nZEGLAST=\"/tmp/zeg_last_seen.txt\"\nZEGHOOK=\"http://localhost:8700/api/webhook/hermes\"\n\n# Get current Hermes sessions\nSESSIONS=$(curl -s --connect-timeout 3 \"http://localhost:8502/api/sessions\" 2>/dev/null | python3 -c \"\nimport sys, json\ntry:\n    sessions = json.load(sys.stdin)\n    for s in sessions:\n        sid = s.get('id','')\n        ended = s.get('ended_at') is not None\n        status = 'ended' if ended else 'active'\n        print(f'{sid}:{status}')\nexcept:\n    pass\n\" 2>/dev/null)\n\n# Get current Zeg health\nzeg_health=$(curl -s --connect-timeout 3 \"http://localhost:8700/api/health\" 2>/dev/null | python3 -c \"import sys,json; d=json.load(sys.stdin); print('healthy') if d.get('status')=='ok' else print('down')\" 2>/dev/null)\n\n# Load previous state\nif [ -f \"$ZEGLAST\" ]; then\n    prev=$(cat \"$ZEGLAST\")\nelse\n    prev=\"\"\nfi\n\n# Write current state\necho \"$SESSIONS\" > \"$ZEGLAST\"\n\n# Detect new/ended sessions and send webhooks\necho \"$SESSIONS\" | while IFS=: read sid status; do\n    if [ -z \"$sid\" ]; then continue; fi\n    prev_line=$(echo \"$prev\" | grep \"^$sid:\" 2>/dev/null)\n    if [ -z \"$prev_line\" ]; then\n        curl -s --connect-timeout 2 -X POST \"$ZEGHOOK\" -H 'Content-Type: application/json' \\\n            -d \"{\\\"type\\\":\\\"session_started\\\",\\\"data\\\":{\\\"session_id\\\":\\\"$sid\\\"}}\" > /dev/null 2>&1\n    elif echo \"$prev_line\" | grep -q \":$status$\"; then\n        : # unchanged\n    else\n        curl -s --connect-timeout 2 -X POST \"$ZEGHOOK\" -H 'Content-Type: application/json' \\\n            -d \"{\\\"type\\\":\\\"session_${status}\\\",\\\"data\\\":{\\\"session_id\\\":\\\"$sid\\\"}}\" > /dev/null 2>&1\n    fi\ndone\n\necho \"Bridge tick: Zeg=$zeg_health, sessions tracked=$(echo \"$SESSIONS\" | wc -l | tr -d ' ')\"",
      "no_agent": true
    }
  ]
